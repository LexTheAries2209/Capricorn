+    // Exercise retry limits without touching disks or actually waiting.
+    struct UnmountCase {
+      std::vector<DAReturn> statuses;
+      unsigned valid_checks;
+      bool expected;
+      unsigned attempts;
+      std::vector<unsigned> delays;
+    };
+    const UnmountCase unmountCases[] = {
+      {{kDAReturnSuccess}, 3, true, 1, {}},
+      {{unix_err(EBUSY), kDAReturnSuccess}, 3, true, 2, {1}},
+      {{kDAReturnBusy, unix_err(EBUSY), kDAReturnSuccess}, 3, true, 3, {1, 2}},
+      {{unix_err(EBUSY), kDAReturnBusy, unix_err(EBUSY)}, 3, false, 3, {1, 2}},
+      {{kDAReturnNotReady}, 3, false, 1, {}}, // Includes an unfinished timeout.
+      {{unix_err(EPERM)}, 3, false, 1, {}},
+      {{unix_err(EBUSY), unix_err(EIO)}, 3, false, 2, {1}},
+      {{unix_err(EBUSY)}, 1, false, 1, {1}}, // Disk changed during the delay.
+      {{kDAReturnSuccess}, 0, false, 0, {}},
+    };
+    for (const auto & test : unmountCases) {
+      unsigned attempts = 0, checks = 0;
+      std::vector<unsigned> delays;
+      std::string error;
+      bool ok = unmount_with_busy_retry(
+        [&](std::string & message) {
+          if (attempts >= test.statuses.size())
+            std::abort();
+          message = "unmount failure";
+          return test.statuses[attempts++];
+        },
+        [&]() { return checks++ < test.valid_checks; },
+        [&](unsigned seconds) { delays.push_back(seconds); }, error);
+      CHECK(ok == test.expected && attempts == test.attempts && delays == test.delays);
+      CHECK(error.empty() == test.expected);
+    }
+
