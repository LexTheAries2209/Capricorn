+static bool capricorn_authorize_device(const darwin_usb_device_info & info,
+  int & error_number, std::string & error_message)
+{
+  auditinfo_addr_t audit = {};
+  const char * expected_user = getenv("CAPRICORN_USBRAW_USER_UID");
+  char * end = nullptr;
+  errno = 0;
+  unsigned long uid = expected_user ? strtoul(expected_user, &end, 10) : 0;
+  int parse_error = errno;
+  int audit_status = getaudit_addr(&audit, sizeof(audit));
+  fprintf(stderr, "CAPRICORN_USBRAW_CONTEXT\tuid=%u euid=%u auid=%u asid=%u audit_status=%d\n",
+    getuid(), geteuid(), audit.ai_auid, audit.ai_asid, audit_status);
+  if (!expected_user || !*expected_user || !end || *end || parse_error
+      || uid == 0 || uid >= UINT32_MAX || geteuid() != 0
+      || audit_status != 0 || audit.ai_auid != uid
+      || audit.ai_asid == AU_DEFAUDITSID) {
+    error_number = EPERM;
+    error_message = "SNT authorization requires root in the requesting GUI user's audit session";
+    return false;
+  }
+  const char * name = strip_bsd_device_path(info.device_name.c_str());
+  if (!is_whole_disk_name(name)) {
+    error_number = ENODEV;
+    error_message = "SNT authorization could not resolve the physical disk";
+    return false;
+  }
+  std::string path = std::string("/dev/r") + name;
+  int fd = ::open(path.c_str(), O_RDONLY | O_NONBLOCK | O_CLOEXEC);
+  if (fd < 0) {
+    error_number = errno;
+    error_message = std::string("SNT authorization preflight could not open ")
+      + path + ": " + strerror(errno)
+      + "; check Capricorn's Removable Volumes permission before retrying";
+    return false;
+  }
+  ::close(fd);
+  fprintf(stderr, "CAPRICORN_USBRAW_ACCESS\tgranted\n");
+  return true;
+}
