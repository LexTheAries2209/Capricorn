+int capricorn_usb_authorization_probe(const char * selector)
+{
+  int error_number = 0;
+  std::string error_message;
+  darwin_usb_device_info info;
+  if (strncmp(selector, "usbraw:", 7)
+      || !darwin_usb_get_device_info(selector, info, error_number, error_message)
+      || !capricorn_authorize_device(info, error_number, error_message)) {
+    fprintf(stderr, "CAPRICORN_USBRAW_PREFLIGHT\tfailed: %s\n",
+      error_message.empty() ? "an explicit usbraw selector is required" : error_message.c_str());
+    return 2;
+  }
+  fprintf(stderr, "CAPRICORN_USBRAW_PREFLIGHT\tpassed (no unmount or capture)\n");
+  return 0;
+}
