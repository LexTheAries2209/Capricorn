+static bool codex_name_identity(CFDictionaryRef description,
+  const darwin_usb_device_info & usb, darwin_mounted_volume & volume)
+{
+  // User-authorized exception for the observed CODEX Compact Drive reader.
+  // Do not generalize name-only matching to other UUID-less USB media.
+  if (usb.vendor_id != 0x2818 || usb.product_id != 0x0012
+      || !usb.location_id || usb.serial_number.empty()
+      || !description_uuid(description, kDADiskDescriptionVolumeUUIDKey).empty()
+      || !description_uuid(description, kDADiskDescriptionMediaUUIDKey).empty()
+      || CFDictionaryGetValue(description, kDADiskDescriptionMediaWholeKey) != kCFBooleanTrue
+      || description_string(description, kDADiskDescriptionMediaNameKey) != "CODEX COMPACT DRIVE Media"
+      || description_string(description, kDADiskDescriptionVolumeKindKey) != "udf")
+    return false;
+  const std::string name = description_string(description, kDADiskDescriptionVolumeNameKey);
+  uint64_t size = description_number(description, kDADiskDescriptionMediaSizeKey);
+  uint64_t block = description_number(description, kDADiskDescriptionMediaBlockSizeKey);
+  if (name.find_first_not_of(" \t\r\n") == std::string::npos
+      || name.find('/') != std::string::npos || !size || !block || block > UINT32_MAX)
+    return false;
+  volume.codex_volume_name = name;
+  volume.media_size = size;
+  volume.block_size = (uint32_t)block;
+  return true;
+}
